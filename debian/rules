#!/usr/bin/make -f
# debian/rules

DH_VERBOSE = 1

# DEB_VERSION: taken from debian/changelog, generated by package.mk
include /usr/share/dpkg/pkg-info.mk

# Canonical install path, also hardcoded in debian/install and debian/postinst
GPBACKUP_HOME := /opt/greengagedb/gpbackup

BINS      := gpbackup gprestore gpbackup_helper
BUILD_DIR := debian/build
MODULE    := github.com/GreengageDB/gpbackup

export DEB_BUILD_OPTIONS = nocheck

# go-sqlite3 requires cgo
export CGO_ENABLED = 1
export GO111MODULE = on
export GOFLAGS = -buildvcs=false -mod=readonly
# debuild resets PATH, so add the default location of the upstream Go tarball
export PATH := /usr/local/go/bin:$(PATH)

%:
	dh $@

# The top-level Makefile is for development builds (installs into
# $GOPATH/bin, requires GOPATH), so bypass it and call go directly.
override_dh_auto_clean:
	rm -rf $(BUILD_DIR)

override_dh_auto_configure:
	@command -v go >/dev/null || { echo "go not found in PATH"; exit 1; }
	@echo "=== $(DEB_SOURCE) $(DEB_VERSION), $$(go version) ==="

# Each binary is selected by a build tag of the same name, and its version
# variable lives in the package of the same name (gpbackup -> backup, ...).
override_dh_auto_build:
	go build -tags gpbackup -o $(BUILD_DIR)/gpbackup \
		-ldflags "-X $(MODULE)/backup.version=$(DEB_VERSION)"
	go build -tags gprestore -o $(BUILD_DIR)/gprestore \
		-ldflags "-X $(MODULE)/restore.version=$(DEB_VERSION)"
	go build -tags gpbackup_helper -o $(BUILD_DIR)/gpbackup_helper \
		-ldflags "-X $(MODULE)/helper.version=$(DEB_VERSION)"

override_dh_auto_install:
	for bin in $(BINS); do \
		install -D -m 755 $(BUILD_DIR)/$$bin debian/tmp$(GPBACKUP_HOME)/bin/$$bin || exit 1; \
	done

override_dh_dwz:
	@echo "Skipping debug symbols compression (not working properly with Golang)"
